#!/bin/bash
# AI Agent wrapper
# - Dynamically launches the desired AI agent implementation
# - Ensures our Claudebox customizations apply consistently to all implementations
set -euo pipefail

PROMPT_FILE=""

# --------------------------------------------------------------------------------------------------
# Agents
# --------------------------------------------------------------------------------------------------

# Executes Claude Code agent
execute-claude() {
  local args=()

  # Check noninteractive mode (forces TUI, overrides web mode)
  if item-in-array "mcp" "$@" || item-in-array "plugin" "$@" || item-in-array "setup-token" "$@" \
    || item-in-array "doctor" "$@" || item-in-array "update" "$@" || item-in-array "install" "$@" \
    || item-in-array "-p" "$@" || item-in-array "--print" "$@"; then
    export __CLAUDEBOX_AGENT_NONINTERACTIVE__=1
  fi

  # Custom system prompt
  if ! has-system-prompt "$@"; then
    write-agent-prompt claude

    if [[ -n $PROMPT_FILE ]]; then
      args+=(--system-prompt-file "$PROMPT_FILE")
    fi
  fi

  # YOLO mode
  # bashsupport disable=BP2001
  export IS_SANDBOX=1
  args+=(--permission-mode bypassPermissions)

  # Build command
  local agent

  if [[ ${CLAUDEBOX_WEB:-0} == 1 ]] && [[ ${__CLAUDEBOX_AGENT_NONINTERACTIVE__:-0} == 0 ]]; then
    agent=$(get-web-server)
    sync-dev-dependencies
  else
    # Not a PATH lookup: the ~/.local/bin/claude shim re-enters this script and may sort first
    agent=$(mise which claude)
  fi

  local agent_cmd
  agent_cmd=$(get-agent-cmd "$agent")

  local cmd=(
    mise exec npm:@anthropic-ai/claude-code --
      /bin/bash -c "$agent_cmd" --
        "${args[@]}"
        "$@"
  )

  # Verbose mode
  if [[ ${CLAUDEBOX_VERBOSE:-0} == 1 ]]; then
    echo "${cmd[*]}"
  fi

  # Launch Claude Code
  "${cmd[@]}"
}

# Executes LangGraph agent
execute-langgraph() {
  # LangGraph runs in-process and ships no terminal interface, so web mode is the only
  # surface it has. Refusing here keeps the failure legible - the alternative is a
  # container that exits before the API server ever binds a port.
  if [[ ${CLAUDEBOX_WEB:-0} != 1 ]]; then
    echo "error: langgraph has no interactive session - it runs in web mode only" >&2
    echo "  -> open the workspace in the web UI, or set agent = \"claude\" to get a terminal" >&2

    return 1
  fi

  sync-dev-dependencies

  local args=()

  # Custom system prompt, compiled from the langgraph-native prompt file. The Claude persona
  # is written against features langgraph does not have, so it gets its own entrypoint file
  # rather than a shared one.
  if ! has-system-prompt "$@"; then
    write-agent-prompt langgraph

    if [[ -n $PROMPT_FILE ]]; then
      args+=(--system-prompt-file "$PROMPT_FILE")
    fi
  fi

  local agent_cmd
  agent_cmd=$(get-agent-cmd "$(get-web-server)")

  local cmd=(
    /bin/bash -c "$agent_cmd" --
      "${args[@]}"
      "$@"
  )

  # Verbose mode
  if [[ ${CLAUDEBOX_VERBOSE:-0} == 1 ]]; then
    echo "${cmd[*]}"
  fi

  # Launch the container API server
  "${cmd[@]}"
}

# --------------------------------------------------------------------------------------------------
# Agent
# --------------------------------------------------------------------------------------------------

# Prints the server that serves web mode, whichever agent is driving it
get-web-server() {
  echo ~/.claudebox/lib/src/container_api_server.py
}

# Syncs dependencies in dev mode, keeping langgraph provider extras so a hot-reload sync
# does not prune the preinstalled provider packages
sync-dev-dependencies() {
  if [[ ${CLAUDEBOX_DEV:-0} != 1 ]]; then
    return 0
  fi

  # The library is mounted read-only, so syncing into it would end the container under `set -e`.
  if [[ ! -w ~/.claudebox/lib ]]; then
    echo "claudebox: dev mode: skipping the dependency sync - the library is mounted read-only" >&2

    return 0
  fi

  (
    export UV_PROJECT_ENVIRONMENT=/opt/claudebox/.venv
    uv sync --directory ~/.claudebox/lib --extra langgraph-all
  )
}

# Compiles prompt starting at the entrypoint prompt file for agent $1 (default: claude), preferring
# the file named after CLAUDEBOX_BUNDLE and never falling back to another agent's
get-agent-prompt() {
  local agent=${1:-claude}
  local base=~/.claudebox/profile/prompt

  if [[ $agent != claude ]]; then
    base=~/.claudebox/profile/prompt.${agent}
  fi

  local candidates=("$base.md")

  if [[ -n ${CLAUDEBOX_BUNDLE:-} ]]; then
    candidates=("$base.$CLAUDEBOX_BUNDLE.md" "$base.md")
  fi

  local prompt_file

  for prompt_file in "${candidates[@]}"; do
    if [[ -e $prompt_file ]]; then
      ~/.local/bin/claudebox-prompt "$prompt_file"

      return
    fi
  done
}

# Compiles the prompt for agent $1 into PROMPT_FILE, left empty when the profile has none - a file,
# because the compiled prompt outgrows the kernel's 128 KiB cap on a single argv or env string
write-agent-prompt() {
  local prompt
  prompt="$(get-agent-prompt "$1")"

  if [[ -z $prompt ]]; then
    return 0
  fi

  # Not /tmp: a session start replaces /tmp while this file must outlive the server
  PROMPT_FILE=$(mktemp --suffix=.md /run/claudebox/prompt.XXXXXX)
  printf '%s' "$prompt" > "$PROMPT_FILE"
}

# Removes the compiled prompt file once the agent exits
remove-agent-prompt() {
  if [[ -n $PROMPT_FILE ]]; then
    rm -f "$PROMPT_FILE"
  fi
}

# Constructs command to execute agent
get-agent-cmd() {
  local agent=${1//\"/\\\"}

  # Alter PATH so nested agent sessions hit this script again
  # shellcheck disable=SC2016
  echo '
    AGENT_PATH=$(which "'"${agent}"'")
    export PATH=~/.local/bin:$PATH
    export CLAUDEBOX_VERBOSE=0
    exec "$AGENT_PATH" "$@"
  '
}

# --------------------------------------------------------------------------------------------------
# Hooks
# --------------------------------------------------------------------------------------------------

# Executes profile hook before interactive session starts
on-agent-start-hook() {
  if [[ ${__CLAUDEBOX_AGENT_START_HOOK_EXECUTED__:-0} == 0 ]] && [[ ${__CLAUDEBOX_AGENT_NONINTERACTIVE__:-0} == 0 ]]; then
    # bashsupport disable=BP2001
    export __CLAUDEBOX_AGENT_START_HOOK_EXECUTED__=1
    export CLAUDEBOX_VERBOSE=0

    local hook_file=~/.claudebox/profile/hooks/agent-start.sh

    if [[ -e $hook_file ]]; then
      "$hook_file"
    fi
  fi
}

# Executes profile hook once interactive session ends
on-agent-stop-hook() {
  if [[ ${__CLAUDEBOX_AGENT_STOP_HOOK_EXECUTED__:-0} == 0 ]] && [[ ${__CLAUDEBOX_AGENT_NONINTERACTIVE__:-0} == 0 ]]; then
    # bashsupport disable=BP2001
    export __CLAUDEBOX_AGENT_STOP_HOOK_EXECUTED__=1
    export CLAUDEBOX_VERBOSE=0

    local hook_file=~/.claudebox/profile/hooks/agent-stop.sh

    if [[ -e $hook_file ]]; then
      "$hook_file"
    fi
  fi
}

# --------------------------------------------------------------------------------------------------
# Utils
# --------------------------------------------------------------------------------------------------

# Checks if $1 exist in $2..N
item-in-array() {
  local item=$1
  shift

  local it

  for it in "$@"; do
    if [[ $it == "$item" ]]; then
      return 0
    fi
  done

  return 1
}

# Checks if $1..N already carry a system prompt
has-system-prompt() {
  item-in-array "--system-prompt" "$@" || item-in-array "--system-prompt-file" "$@"
}

# --------------------------------------------------------------------------------------------------
# Main
# --------------------------------------------------------------------------------------------------

main() {
  # bashsupport disable=BP2001
  CLAUDEBOX_PWD=$(pwd)
  export CLAUDEBOX_PWD

  # Hooks
  on-agent-start-hook
  trap 'remove-agent-prompt; on-agent-stop-hook' EXIT

  # Execute agent
  local agent=${1:-}
  shift

  case "$agent" in
    claude)
      execute-claude "$@"
      ;;

    langgraph)
      execute-langgraph "$@"
      ;;

    *)
      echo "Usage: $0 {claude|langgraph} [<arg>...]"
      exit 1
      ;;
  esac
}

main "$@"
