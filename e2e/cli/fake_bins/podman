#!/bin/bash
# Fake podman for hermetic CLI e2e tests. Records args; returns canned output.

set -euo pipefail

echo "$@" >> "${CLAUDEBOX_TEST_RECORD_DIR:?CLAUDEBOX_TEST_RECORD_DIR unset}/podman.log"

case "${1:-}" in
    --version) echo "podman version 4.9.0-fake"; exit 0 ;;
    info)      echo "graphDriverName: vfs"; exit 0 ;;
    image)
        case "${2:-}" in
            prune) echo "Total reclaimed space: 0B"; exit 0 ;;
        esac
        ;;
    container)
        case "${2:-}" in
            prune) echo "Total reclaimed space: 0B"; exit 0 ;;
        esac
        ;;
    ps) echo "[]"; exit 0 ;;
    *) exit 0 ;;
esac
